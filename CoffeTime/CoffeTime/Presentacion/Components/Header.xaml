<UserControl x:Class="CoffeTime.Presentacion.Components.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="80"
             Background="#FFF8F4E9">

    <Border Background="White"
            BorderBrush="#E6D5B8"
            BorderThickness="0,0,0,1">

        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- LOGO -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Presentacion/Resources/logo.png"
                       Width="45"
                       Height="45"
                       Margin="0,0,10,0"/>

                <StackPanel>
                    <TextBlock Text="CoffeeTime"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#8B5E34"/>
                    <TextBlock Text="Sistema de Gestión"
                               FontSize="11"
                               Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <!-- MENÚ -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Center">

                <Button Content="🏠 Dashboard"  Tag="Dashboard"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="👥 Usuarios"    Tag="Usuarios"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="🍪 Productos"   Tag="Productos"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="🛒 Pedidos"     Tag="Pedidos"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="📦 Inventario"  Tag="Inventario"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="🤝 Proveedores" Tag="Proveedores"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="📊 Reportes"    Tag="Reportes"
                        Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
            </StackPanel>

            <!-- PERFIL + HORA + LOGOUT -->
            <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Right">

                <!-- HORA -->
                <TextBlock x:Name="TxtHora"
               FontSize="14"
               Foreground="#6B4F2A"
               VerticalAlignment="Center"
               Margin="0 0 15 0"/>

                <!-- ICONO + USUARIO -->
                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0 0 15 0">

                    <TextBlock Text="👤"
                   FontSize="20"
                   Margin="0,0,5,0"
                   VerticalAlignment="Center"/>

                    <StackPanel>
                        <TextBlock x:Name="TxtNombre"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtRol"
                       FontSize="11"
                       Foreground="Gray"
                       HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>

                <!-- LOGOUT -->
                <Button Content="🔓 Salir"
            Background="#E53935"
            Foreground="White"
            BorderThickness="0"
            Padding="10 4"
            Click="LogoutClick"
            Cursor="Hand"/>
            </StackPanel>


        </Grid>
    </Border>

</UserControl>
