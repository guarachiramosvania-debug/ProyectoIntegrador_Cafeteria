<UserControl x:Class="CoffeTime.Presentacion.Components.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="80"
             Background="#FFF8F4E9">

    <Border Background="White"
            BorderBrush="#E6D5B8"
            BorderThickness="0,0,0,1">

        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- LOGO -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Presentacion/Resources/logo.png" Width="45" Height="45" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="CoffeeTime" FontWeight="Bold" FontSize="16" Foreground="#8B5E34"/>
                    <TextBlock Text="Sistema de Gestión" FontSize="11" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <!-- MENÚ PRINCsIPAL -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Center">

                <Button Content="🏠 Dashboard"  Tag="Dashboard"   Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="👥 Usuarios"    Tag="Usuarios"    Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="🍪 Productos"   Tag="Productos"   Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="🛒 Pedidos"     Tag="Pedidos"     Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="📦 Inventario"  Tag="Inventario"  Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="🤝 Proveedores" Tag="Proveedores" Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
                <Button Content="📊 Reportes"    Tag="Reportes"    Style="{StaticResource MenuButtonStyle}" Click="MenuClick"/>
            </StackPanel>

            <!-- PERFIL + LOGOUT -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="TxtNombre" Text="Usuario" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtRol" Text="Rol" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                </StackPanel>

                <Button Content="🔓 Salir"
                        Background="#E53935"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="10 4"
                        Click="LogoutClick"
                        Cursor="Hand"/>
            </StackPanel>

        </Grid>
    </Border>

</UserControl>
