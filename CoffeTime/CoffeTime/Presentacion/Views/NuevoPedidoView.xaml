<Window x:Class="CoffeTime.Presentacion.Views.NuevoPedidoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:CoffeTime.Presentacion.Components"
        Title="Nuevo Pedido"
       Width="1300"
        Height="750"
        MinWidth="1200"
        MinHeight="750"
        Background="#FFF8F4E9"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <components:Header Grid.Row="0"/>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ================== CATÁLOGO DE PRODUCTOS ================== -->
            <Border Background="White"
                    BorderBrush="#E0D5C5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0 0 15 0">

                <DockPanel>

                    <!-- Título + Buscador -->
                    <StackPanel DockPanel.Dock="Top" Margin="0 0 0 10">
                        <TextBlock Text="Productos"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#8B5E34"/>

                        <!-- Buscador (SIN PlaceholderText, compatible WPF) -->
                        <Grid Height="30" Margin="0 8 0 0">
                            <TextBox x:Name="TxtBuscarProducto"
                                     TextChanged="TxtBuscarProducto_TextChanged"
                                     Background="White"
                                     BorderBrush="#C6B7A8"
                                     BorderThickness="1"
                                     Padding="6"/>

                            <TextBlock x:Name="TxtBuscarPlaceholder"
                                       Text="Buscar producto..."
                                       Foreground="#999"
                                       Margin="10,5,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="Visible"/>
                        </Grid>
                    </StackPanel>


                    <!-- Tabla de productos -->
                    <DataGrid x:Name="dgProductos"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Margin="0 10 0 0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Categoría"
                                                Binding="{Binding Categoria}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding Precio, StringFormat='Bs {0:F2}'}"
                                                Width="90"/>

                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Agregar"
                                                Padding="8,2"
                                                Margin="4,0"
                                                Tag="{Binding Id}"
                                                Background="#4CAF50"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="BtnAgregarProducto_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </Border>


            <!-- ================== DETALLE DEL PEDIDO ================== -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E0D5C5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="Detalle del Pedido"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#8B5E34"/>

                    <DataGrid x:Name="dgDetalle"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Margin="0 10 0 0"
                              Height="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto"
                                                Binding="{Binding NombreProducto}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Cant."
                                                Binding="{Binding Cantidad}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding Precio, StringFormat='Bs {0:F2}'}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Subtotal"
                                                Binding="{Binding Subtotal, StringFormat='Bs {0:F2}'}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>


                    <!-- TOTAL + MÉTODO DE PAGO -->
                    <StackPanel Margin="0 10 0 0">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Total:"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0 0 8 0"/>
                            <TextBlock x:Name="TxtTotal"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#8B5E34"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0 10 0 0">
                            <TextBlock Text="Método de pago:"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="CmbMetodoPago"
                                      Width="150"
                                      Margin="10 0 0 0">
                                <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                                <ComboBoxItem Content="Tarjeta"/>
                                <ComboBoxItem Content="Yape / QR"/>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>


                    <!-- BOTONES -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0 15 0 0">
                        <Button Content="Guardar Pedido"
                                Padding="16,4"
                                Margin="0 0 10 0"
                                Background="#E0912D"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="BtnGuardar_Click"/>

                        <Button Content="Cerrar"
                                Padding="14,4"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
    </Grid>
</Window>
