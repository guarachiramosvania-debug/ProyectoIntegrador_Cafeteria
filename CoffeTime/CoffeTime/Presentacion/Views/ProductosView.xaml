<Window x:Class="CoffeTime.Presentacion.Views.ProductosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:CoffeTime.Presentacion.Components"
        Title="Gestión de Productos"
        Height="900" Width="1400"
        Background="#FFF8F4E9"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <components:Header Grid.Row="0"/>

        <!-- CONTENIDO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <!-- Título + botón nuevo -->
                <DockPanel Margin="0,0,0,20">
                    <Button Content="+ Nuevo Producto"
                            Style="{StaticResource MainButton}"
                            DockPanel.Dock="Right"
                            Padding="18,8"
                            Click="BtnNuevoProducto"/>

                    <StackPanel>
                        <TextBlock Text="Gestión de Productos"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#4A2E0F"/>
                        <TextBlock Text="Administra el catálogo de productos"
                                   Foreground="#7A6A58"/>
                    </StackPanel>
                </DockPanel>

                <!-- 🔍 BUSCADOR + FILTROS -->
                <Border Background="White"
                        CornerRadius="8"
                        Padding="10"
                        BorderBrush="#D6C7B4"
                        BorderThickness="1"
                        Margin="0,0,0,15">

                    <StackPanel Orientation="Horizontal" Margin="10">

                        <!-- BUSCADOR con placeholder -->
                        <Grid Width="220" Margin="0,0,10,0">
                            <TextBox x:Name="TxtBuscar"
                                     Height="32"
                                     TextChanged="TxtBuscar_TextChanged"/>

                            <!-- Placeholder REAL -->
                            <TextBlock x:Name="TxtBuscarPlaceholder"
                                       Text="Buscar..."
                                       Foreground="#999"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- CATEGORÍAS -->
                        <ComboBox x:Name="CmbCategorias"
                                  Width="180"
                                  Height="32"
                                  SelectionChanged="FiltrarProductos"/>
                    </StackPanel>

                </Border>

                <!-- GRID de productos -->
                <ItemsControl x:Name="ListaProductos">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"
                                       Orientation="Horizontal"
                                       ItemWidth="280"
                                       ItemHeight="Auto"
                                       Margin="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- TARJETA -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border CornerRadius="12"
                                    Background="White"
                                    Margin="10"
                                    Padding="12"
                                    BorderBrush="#E2DCC8"
                                    BorderThickness="1"
                                    Width="260">

                                <StackPanel>

                                    <!-- IMAGEN + INFO -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Image Source="{Binding ImagenUrl}"
                                               Width="60" Height="60"
                                               Margin="0,0,10,0"/>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="16"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="{Binding Categoria}"
                                                       Foreground="#777"/>

                                            <TextBlock Text="{Binding Precio, StringFormat='Bs {0:F2}'}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- EXPANDER -->
                                    <Expander Header="Ver más">
                                        <StackPanel Margin="0,10,0,0">

                                            <TextBlock Text="{Binding Descripcion}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#444"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="✏ Editar"
                                                        Tag="{Binding Id}"
                                                        Width="80"
                                                        Margin="0,0,10,0"
                                                        Click="EditarProducto"/>

                                                <Button Content="🗑 Eliminar"
                                                        Tag="{Binding Id}"
                                                        Width="80"
                                                        Background="#F8C4C4"
                                                        BorderBrush="#D77"
                                                        Click="EliminarProducto"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </Expander>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- MODAL DE EDICIÓN -->
        <Border x:Name="ModalFondo"
                Background="#AA000000"
                Visibility="Collapsed"
                Grid.RowSpan="2">

            <Border Width="450"
                    Background="White"
                    Padding="20"
                    CornerRadius="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Editar Producto"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <!-- Inputs SIN placeholder -->
                    <TextBox x:Name="TxtNombreEdit" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtCategoriaEdit" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtPrecioEdit" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtDescripcionEdit" Margin="0,0,0,10"/>

                    <Button Content="Guardar"
                            Margin="0,10,0,0"
                            Click="GuardarEdicion"/>

                    <Button Content="Cancelar"
                            Background="#F8C4C4"
                            Margin="0,10,0,0"
                            Click="CerrarModal"/>
                </StackPanel>

            </Border>
        </Border>

    </Grid>
</Window>
