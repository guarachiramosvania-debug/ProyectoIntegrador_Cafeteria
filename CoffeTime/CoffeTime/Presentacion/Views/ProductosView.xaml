<Window x:Class="CoffeTime.Presentacion.Views.ProductosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:CoffeTime.Presentacion.Components"
        mc:Ignorable="d"
        Title="Gestión de Productos"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <Window.Resources>
        <ResourceDictionary Source="/CoffeTime;component/Presentacion/Resources/Styles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:Header Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">

                <DockPanel Margin="0,0,0,20">
                    <Button Content="+ Nuevo Producto"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MainButton}"
                            Padding="20,10"
                            Click="BtnNuevoProducto"/>

                    <StackPanel>
                        <TextBlock Text="Gestión de Productos"
                                   Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Administra el catálogo de productos"
                                   Style="{StaticResource SubtitleText}"/>
                    </StackPanel>
                </DockPanel>

                <ItemsControl x:Name="listaProductos">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource CardStyle}"
                                    Padding="15" Margin="8,0,8,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Width="50" Height="50"
                                               Fill="#EAEAEA"
                                               RadiusX="5" RadiusY="5"
                                               Margin="0,0,15,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDarkBrush}"/>

                                        <TextBlock Text="{Binding Categoria}"
                                                   Foreground="{StaticResource TextLightBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Precio, StringFormat='${0:F2}'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>

                                    <StackPanel Grid.Column="3"
                                                VerticalAlignment="Center">

                                        <Button Content="✏ Editar"
                                                Tag="{Binding Id}"
                                                Background="#FDECC2"
                                                BorderBrush="#C9A96D"
                                                Margin="0,0,0,5"
                                                Click="EditarProducto"/>

                                        <Button Content="🗑 Eliminar"
                                                Tag="{Binding Id}"
                                                Background="#F8C4C4"
                                                BorderBrush="#DB6E6E"
                                                Click="EliminarProducto"/>
                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
