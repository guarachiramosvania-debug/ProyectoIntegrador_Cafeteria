<Window x:Class="CoffeTime.Presentacion.Views.PedidosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Pedidos" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <!-- TÍTULO -->
            <StackPanel>
                <TextBlock Text="Gestión de Pedidos"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#8B5E34"/>
                <TextBlock Text="Administra los pedidos del día"
                           Foreground="Gray"
                           FontSize="14"
                           Margin="0 5 0 30"/>
            </StackPanel>

            <!-- BOTÓN NUEVO PEDIDO -->
            <Button x:Name="btnNuevoPedido"
                    Content="+   Nuevo Pedido"
                    Width="160"
                    Height="40"
                    HorizontalAlignment="Right"
                    Margin="0 0 0 25"
                    Background="#E0912D"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- LISTA DE PEDIDOS -->
            <ItemsControl x:Name="icListaPedidos">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="White"
                                BorderBrush="#E3C7A4"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0 0 0 20"
                                Padding="20">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <!-- ================== IZQUIERDA ================== -->
                                <StackPanel>

                                    <!-- TÍTULO DEL PEDIDO Y ESTADO -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NombrePedido}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#734a2e"/>

                                        <!-- ETIQUETA DE ESTADO -->
                                        <Border Background="#C8E6C9"
                                                Padding="6 2"
                                                CornerRadius="10"
                                                Margin="10 0 0 0">
                                            <TextBlock Text="{Binding Estado}"
                                                       Foreground="#1B5E20"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- FECHA -->
                                    <TextBlock Text="{Binding FechaHora}"
                                               FontSize="12"
                                               Foreground="Gray"
                                               Margin="0 3 0 10"/>

                                    <!-- PRODUCTOS DEL PEDIDO -->
                                    <ItemsControl ItemsSource="{Binding Productos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="•  {Binding}"
                                                           FontSize="14"
                                                           Foreground="#333"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- BOTÓN CANCELAR -->
                                    <Button Content="Cancelar Pedido"
                                            Width="150"
                                            Height="28"
                                            Margin="0 15 0 0"
                                            Background="Transparent"
                                            BorderBrush="Red"
                                            BorderThickness="1.2"
                                            Foreground="Red"
                                            Cursor="Hand"/>
                                </StackPanel>

                                <!-- ================== DERECHA ================== -->
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Total}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#8B5E34"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Text="{Binding MetodoPago}"
                                               FontSize="12"
                                               Foreground="Gray"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>
</Window>
