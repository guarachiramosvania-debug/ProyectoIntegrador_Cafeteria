<Window x:Class="CoffeTime.Presentacion.Views.PedidosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoffeTime.Presentacion.Converters"
        xmlns:components="clr-namespace:CoffeTime.Presentacion.Components"
        Title="Gestión de Pedidos"
        Height="750" Width="1150"
        Background="#FFF8F4E9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:EstadoToColorConverter x:Key="EstadoToColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <components:Header Grid.Row="0"/>

        <!-- CONTENIDO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <!-- TÍTULO -->
                <StackPanel>
                    <TextBlock Text="Gestión de Pedidos"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#8B5E34"/>

                    <TextBlock Text="Administra los pedidos activos"
                               Foreground="Gray"
                               FontSize="14"
                               Margin="0 5 0 25"/>
                </StackPanel>

                <!-- LISTA -->
                <ItemsControl x:Name="icListaPedidos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="White"
                                    Padding="20"
                                    Margin="0 0 0 15"
                                    CornerRadius="12"
                                    BorderBrush="#E0D5C5"
                                    BorderThickness="1">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- IZQUIERDA -->
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                            <TextBlock Text="{Binding NombrePedido}"
                                                       FontWeight="Bold"
                                                       FontSize="20"
                                                       Foreground="#6B4F2A"/>

                                            <!-- ESTADO -->
                                            <Border Background="{Binding Estado, Converter={StaticResource EstadoToColorConverter}}"
                                                    Padding="5 2"
                                                    CornerRadius="8"
                                                    Margin="10 0 0 0">
                                                <TextBlock Text="{Binding Estado}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- FECHA -->
                                        <TextBlock Text="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                   Foreground="Gray"
                                                   FontSize="12"/>

                                        <!-- PRODUCTOS DEL PEDIDO -->
                                        <ItemsControl ItemsSource="{Binding Productos}"
                                                      Margin="0 10 0 0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" />

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- BOTONES -->
                                        <StackPanel Orientation="Horizontal" Margin="0 15 0 0">

                                            <Button Content="Pagar"
                                                    Tag="{Binding IdPedido}"
                                                    Width="90"
                                                    Margin="0 0 10 0"
                                                    Background="#4CAF50"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"
                                                    Click="BtnPagarPedido_Click"/>

                                            <Button Content="Cancelar"
                                                    Tag="{Binding IdPedido}"
                                                    Width="90"
                                                    Background="#FFCDD2"
                                                    Foreground="#B71C1C"
                                                    BorderBrush="#B71C1C"
                                                    Cursor="Hand"
                                                    Click="BtnCancelarPedido_Click"/>
                                        </StackPanel>

                                    </StackPanel>

                                    <!-- DERECHA -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">

                                        <TextBlock Text="{Binding Total, StringFormat={}{0:F2}}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#8B5E34"/>

                                        <TextBlock Text="{Binding MetodoPago}"
                                                   Foreground="Gray"
                                                   FontSize="12"/>
                                    </StackPanel>

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="btnNuevoPedido"
                Content="+   Nuevo Pedido"
                Background="#E0912D"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnNuevoPedido_Click"
                Margin="968,35,22,579"
                Grid.Row="1"/>
    </Grid>
</Window>
