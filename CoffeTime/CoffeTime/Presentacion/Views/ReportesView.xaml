<Window x:Class="CoffeTime.Presentacion.Views.ReportesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:CoffeTime.Presentacion.Components"
        Title="Reportes y Estadísticas"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:Header Grid.Row="0"/>


        <Image Source="/Presentacion/Resources/logo.png" Width="45" Height="45" Margin="10,10,1045,25"/>


        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="30">

                <TextBlock Text="Reportes y Estadísticas"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#8B5E34"
                           Margin="0,0,0,20"/>

                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,30">

                    <Border CornerRadius="15" Margin="5" Background="White"
                            Padding="15" BorderBrush="#F1D5A5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ventas Totales" FontWeight="Bold" Foreground="#8B5E34"/>
                            <TextBlock x:Name="txtVentasTotales" 
                                       FontSize="22" FontWeight="Bold" Margin="0,5,0,0"
                                       Foreground="#E0912D"/>
                            <TextBlock Text="Desde el inicio" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="15" Margin="5" Background="White"
                            Padding="15" BorderBrush="#F1D5A5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Total de Pedidos" FontWeight="Bold" Foreground="#8B5E34"/>
                            <TextBlock x:Name="txtTotalPedidos" Text="0"
                                       FontSize="22" FontWeight="Bold" Margin="0,5,0,0"
                                       Foreground="#E0912D"/>
                            <TextBlock Text="Pedidos completados" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="15" Margin="5" Background="White"
                            Padding="15" BorderBrush="#F1D5A5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ticket Promedio" FontWeight="Bold" Foreground="#8B5E34"/>
                            <TextBlock x:Name="txtTicketPromedio" 
                                       FontSize="22" FontWeight="Bold" Margin="0,5,0,0"
                                       Foreground="#E0912D"/>
                            <TextBlock Text="Por pedido" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="15" Margin="5" Background="#E0912D">
                        <Button x:Name="btnExportarReporte"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontWeight="Bold"
                                Content="Exportar Reporte"
                                Click="BtnExportarReporte_Click" />
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Ventas por Día" Grid.Column="0" FontWeight="Bold" BorderBrush="#F1D5A5">
                        <StackPanel Margin="10">
                            <DataGrid x:Name="dgVentasPorDia"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="*"/>
                                    <DataGridTextColumn Header="Pedidos" Binding="{Binding CantidadPedidos}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalVentas, StringFormat=C2}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Productos Más Vendidos" Grid.Column="1" FontWeight="Bold" BorderBrush="#F1D5A5">
                        <StackPanel Margin="10">
                            <DataGrid x:Name="dgProductosMasVendidos"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="50"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                    <DataGridTextColumn Header="Vendidos" Binding="{Binding CantidadVendida}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding MontoTotal, StringFormat=C2}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <GroupBox Header="Ventas Mensuales" FontWeight="Bold" BorderBrush="#F1D5A5">
                    <StackPanel Margin="10">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Año:"/>
                            <TextBox x:Name="txtAnioReportes" Width="80" Margin="5,0,0,0"/>
                            <Button x:Name="btnCargarVentasMensuales"
                                    Content="Cargar"
                                    Width="100"
                                    Margin="10,0,0,0"
                                    Click="BtnCargarVentasMensuales_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="dgVentasMensuales"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mes" Binding="{Binding MesNombre}" Width="*"/>
                                <DataGridTextColumn Header="Pedidos" Binding="{Binding CantidadPedidos}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalVentas, StringFormat=C2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>