<Window x:Class="CoffeTime.Presentacion.Views.ReportesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportes y Estadísticas" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <ScrollViewer>
        <StackPanel Margin="30">

            <TextBlock Text="Reportes y Estadísticas"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#8B5E34"
                       Margin="0,0,0,20"/>

            <!-- TARJETAS SUPERIORES -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,30">

                <!-- Ventas totales -->
                <Border CornerRadius="15" Margin="5" Background="White"
                        Padding="15" BorderBrush="#F1D5A5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ventas Totales" FontWeight="Bold" Foreground="#8B5E34"/>
                        <TextBlock x:Name="txtVentasTotales" Text="$0.00"
                                   FontSize="22" FontWeight="Bold" Margin="0,5,0,0"
                                   Foreground="#E0912D"/>
                        <TextBlock Text="Desde el inicio" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Total pedidos -->
                <Border CornerRadius="15" Margin="5" Background="White"
                        Padding="15" BorderBrush="#F1D5A5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total de Pedidos" FontWeight="Bold" Foreground="#8B5E34"/>
                        <TextBlock x:Name="txtTotalPedidos" Text="0"
                                   FontSize="22" FontWeight="Bold" Margin="0,5,0,0"
                                   Foreground="#E0912D"/>
                        <TextBlock Text="Pedidos completados" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Ticket promedio -->
                <Border CornerRadius="15" Margin="5" Background="White"
                        Padding="15" BorderBrush="#F1D5A5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ticket Promedio" FontWeight="Bold" Foreground="#8B5E34"/>
                        <TextBlock x:Name="txtTicketPromedio" Text="$0.00"
                                   FontSize="22" FontWeight="Bold" Margin="0,5,0,0"
                                   Foreground="#E0912D"/>
                        <TextBlock Text="Por pedido" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Botón exportar -->
                <Border CornerRadius="15" Margin="5" Background="#E0912D">
                    <Button x:Name="btnExportarReporte"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="Bold"
                            Content="Exportar Reporte"/>
                </Border>
            </UniformGrid>

            <!-- VENTAS POR DÍA Y PRODUCTOS MÁS VENDIDOS -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas por día -->
                <GroupBox Header="Ventas por Día" Grid.Column="0" FontWeight="Bold" BorderBrush="#F1D5A5">
                    <StackPanel Margin="10">
                        <DataGrid x:Name="dgVentasPorDia"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*"/>
                                <DataGridTextColumn Header="Pedidos" Binding="{Binding CantidadPedidos}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalVentas}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <!-- Productos más vendidos -->
                <GroupBox Header="Productos Más Vendidos" Grid.Column="1" FontWeight="Bold" BorderBrush="#F1D5A5">
                    <StackPanel Margin="10">
                        <DataGrid x:Name="dgProductosMasVendidos"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="50"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                <DataGridTextColumn Header="Vendidos" Binding="{Binding CantidadVendida}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding MontoTotal}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- VENTAS MENSUALES -->
            <GroupBox Header="Ventas Mensuales" FontWeight="Bold" BorderBrush="#F1D5A5">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="Año:"/>
                        <TextBox x:Name="txtAnioReportes" Width="80" Margin="5,0,0,0"/>
                        <Button x:Name="btnCargarVentasMensuales"
                                Content="Cargar"
                                Width="100"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="dgVentasMensuales"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mes" Binding="{Binding MesNombre}" Width="*"/>
                            <DataGridTextColumn Header="Pedidos" Binding="{Binding CantidadPedidos}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalVentas}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
