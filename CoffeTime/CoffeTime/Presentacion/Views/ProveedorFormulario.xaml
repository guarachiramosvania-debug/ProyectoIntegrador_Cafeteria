<Window x:Class="CoffeTime.Presentacion.Views.ProveedorFormulario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedor" Width="400" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <StackPanel Margin="20">
        <TextBlock Text="Proveedor" FontSize="24" FontWeight="Bold" Foreground="#7B4F1D"/>

        <Label Content="Nombre"/>
        <TextBox x:Name="txtNombre"/>

        <Label Content="Contacto"/>
        <TextBox x:Name="txtContacto"/>

        <Label Content="Email"/>
        <TextBox x:Name="txtEmail"/>

        <Label Content="Teléfono"/>
        <TextBox x:Name="txtTelefono"/>

        <Button Content="Guardar"
                Margin="0,20,0,0"
                Padding="10"
                Background="#DA8A2D"
                Foreground="White"
               Click="BtnGuardar_Click"/>
    </StackPanel>
</Window>
