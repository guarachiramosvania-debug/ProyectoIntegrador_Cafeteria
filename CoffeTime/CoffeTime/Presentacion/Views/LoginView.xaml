<Window x:Class="CoffeTime.Presentacion.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Login"
        Width="900" Height="656"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Grid>

        <!-- FONDO DEGRADADO -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B85C0F" Offset="0" />
                <GradientStop Color="#E08A1E" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- TARJETA BLANCA -->
        <Border Width="420"
                Padding="35"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="2"
                                  Color="#55000000"/>
            </Border.Effect>

            <StackPanel>



                <Image Source="/Presentacion/Resources/logo.png" Width="186" Height="117" Margin="0,0,10,0"/>

                <!-- TÍTULO -->
                <TextBlock Text="CoffeeTime"
                           HorizontalAlignment="Center"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="#6A3E12" Height="59" Width="220"/>

                <TextBlock Text="Sistema de Gestión"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           Margin="0,3,0,25"
                           Foreground="#8B6C4A"/>

                <!-- USUARIO -->
                <TextBlock Text="Usuario"
                           FontWeight="SemiBold"
                           Margin="5,0,0,5"
                           Foreground="#6A3E12" FontSize="18"/>

                <Border BorderBrush="#D8C6A1" BorderThickness="1.3" CornerRadius="10" Padding="8" Background="White" Height="53">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Margin="0,0,5,0" Source="https://marketplace.canva.com/A5alg/MAESXCA5alg/1/tl/canva-user-icon-MAESXCA5alg.png" Stretch="Fill"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Grid.Column="1"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="3"
                                 Foreground="#333"/>
                    </Grid>
                </Border>

                <!-- CONTRASEÑA -->
                <TextBlock Text="Contraseña"
                           FontWeight="SemiBold"
                           Margin="5,20,0,5"
                           Foreground="#6A3E12" FontSize="18"/>

                <Border BorderBrush="#D8C6A1" BorderThickness="1.3" CornerRadius="10" Padding="8" Background="White" Height="56">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="34*"/>
                            <ColumnDefinition Width="269*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Presentacion\Assets\Productos\candado.jpg" />


                        <PasswordBox x:Name="PasswordPasswordBox"
                                     Grid.Column="1"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="3"
                                     Foreground="#333" Grid.ColumnSpan="2"/>


                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorTextBlock" 
    Foreground="Red"
    HorizontalAlignment="Center"
    Margin="0,15,0,5"
    FontWeight="SemiBold"
    TextWrapping="Wrap" 
    TextAlignment="Center">
                </TextBlock>

                <!-- BOTÓN LOGIN -->
                <Button Click="LoginButton_Click"
                        Margin="0,30,0,0"
                        Height="64"
                        Cursor="Hand"
                        Background="#C67611"
                        Foreground="White"
                        FontSize="22"
                        BorderThickness="0">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="" FontFamily="FontAwesome" Margin="0,0,8,0"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#C67611"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#d47f12"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
Iniciar Sesion
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</Window>
