<Window x:Class="CoffeTime.Presentacion.Views.NuevoProductoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Producto"
        Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <TextBlock Text="Nuevo Producto"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#4A2E0F"
                       Margin="0,0,0,20" />

            <!-- NOMBRE -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Nombre" Foreground="#7A6A58"/>
                <TextBox x:Name="TxtNombre"
                         Height="32"
                         Padding="8"/>
            </StackPanel>

            <!-- CATEGORÍA -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Categoría" Foreground="#7A6A58"/>
                <TextBox x:Name="TxtCategoria"
                         Height="32"
                         Padding="8"/>
            </StackPanel>

            <!-- PRECIO -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Precio" Foreground="#7A6A58"/>
                <TextBox x:Name="TxtPrecio"
                         Height="32"
                         Padding="8"/>
            </StackPanel>

            <!-- DESCRIPCIÓN -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Descripción" Foreground="#7A6A58"/>
                <TextBox x:Name="TxtDescripcion"
                         Height="70"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </StackPanel>

            <Separator Margin="0,10"/>

            <!-- LISTA INSUMOS -->
            <TextBlock Text="Ingredientes / Insumos"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,10"/>

            <ItemsControl x:Name="ListaInsumos">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4">

                            <TextBlock Text="{Binding Nombre}"
                                       Width="160"
                                       VerticalAlignment="Center"/>

                            <!-- Cantidad para este insumo -->
                            <TextBox x:Name="CantidadBox"
                                     Width="70"
                                     Height="26"
                                     Margin="10,0"
                                     Tag="{Binding IdInsumo}"/>

                            <TextBlock Text="{Binding UnidadMedida}"
                                       VerticalAlignment="Center"
                                       Foreground="#666"/>
                        </StackPanel>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!-- BOTÓN GUARDAR -->
            <Button Content="Guardar Producto"
                    Margin="0,20,0,0"
                    Padding="10"
                    Height="40"
                    Background="#C28E5A"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="GuardarProducto"/>

        </StackPanel>

    </ScrollViewer>
</Window>
