<Window x:Class="CoffeTime.Presentacion.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:CoffeTime.Presentacion.Components"
        Title="Dashboard"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <comp:Header Grid.Row="0"/>
        <Image Source="/Presentacion/Resources/logo.png" Width="45" Height="45" Margin="10,18,1045,18"/>

        <ScrollViewer Grid.Row="1" Padding="40" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Dashboard"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#8B5E34"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Resumen de operaciones del día"
                           FontSize="16"
                           Foreground="#937755"
                           Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="10"
                            Background="White"
                            Padding="20"
                            Margin="0,0,20,0"
                            BorderBrush="#E8D5B5"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="Bs" DockPanel.Dock="Right"
                                       FontSize="20"
                                       VerticalAlignment="Top"
                                       Foreground="#8B5E34"/>
                            <StackPanel>
                                <TextBlock Text="Ventas del Día" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VentasDelDia, StringFormat='C2'}"
                                           FontSize="36" FontWeight="Bold" Foreground="#DA8A2D"/>
                                <TextBlock Text="Actualizado en tiempo real" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1"
                            CornerRadius="10"
                            Background="White"
                            Padding="20"
                            Margin="0,0,20,0"
                            BorderBrush="#E8D5B5"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="🛒" DockPanel.Dock="Right"
                                       FontSize="20"
                                       VerticalAlignment="Top"
                                       Foreground="#DA8A2D"/>
                            <StackPanel>
                                <TextBlock Text="Pedidos del Día" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PedidosDelDia}"
                                           FontSize="36" FontWeight="Bold" Foreground="#DA8A2D"/>
                                <TextBlock Text="Pedidos completados" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="10"
                            Background="White"
                            Padding="20"
                            Margin="0,0,20,0"
                            BorderBrush="#E8D5B5"
                            BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="⚠️" DockPanel.Dock="Right"
                                       FontSize="20"
                                       VerticalAlignment="Top"
                                       Foreground="#FFC107"/>
                            <StackPanel>
                                <TextBlock Text="Alertas de Stock" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AlertasDeStock}"
                                           FontSize="36" FontWeight="Bold" Foreground="#FFC107"/>
                                <TextBlock Text="Insumos con stock bajo" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Button Grid.Column="3"
                            Background="#B66A1B"
                            Foreground="White"
                            Padding="10"
                            Margin="20,0,0,0"
                            Click="btnNuevoPedidoRapido_Click"  Command="{Binding NewQuickOrderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,10,0"/>
                            <TextBlock Text="Nuevo Pedido Rápido" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="Acceso Rápido" FontSize="18" Margin="0,0,0,20"/>

                <WrapPanel>
                    <Button Width="200" Height="100"
                            Background="White"
                            BorderBrush="#E8D5B5"
                            BorderThickness="1"
                            Click="btnAccesoPedidos_Click"
                            Margin="0,0,20,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="36" Foreground="#DA8A2D"/>
                            <TextBlock Text="Pedidos" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Width="200" Height="100"
                            Background="White"
                            BorderBrush="#E8D5B5"
                            BorderThickness="1"
                            Click="btnAccesoInventario_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="36" Foreground="#FFC107"/>
                            <TextBlock Text="Inventario" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>