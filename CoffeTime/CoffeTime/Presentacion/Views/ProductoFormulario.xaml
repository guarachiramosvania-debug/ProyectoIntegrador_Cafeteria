<Window x:Class="CoffeTime.Presentacion.Views.ProductoFormulario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto"
        Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F4E9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Producto"
                   FontSize="22" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Margin="0,20,0,0">

            <TextBlock Text="Nombre"/>
            <TextBox x:Name="txtNombre" Margin="0,5,0,15"/>

            <TextBlock Text="Categoría"/>
            <TextBox x:Name="txtCategoria" Margin="0,5,0,15"/>

            <TextBlock Text="Precio"/>
            <TextBox x:Name="txtPrecio" Margin="0,5,0,15"/>

            <TextBlock Text="Descripción"/>
            <TextBox x:Name="txtDescripcion" Margin="0,5,0,15"
                     Height="80" TextWrapping="Wrap"/>

            <TextBlock Text="Imagen"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Seleccionar..."
                        Click="BtnSeleccionarImagen_Click"
                        Margin="0,5,10,15"/>
                <Image x:Name="imgPreview"
                       Width="80" Height="80"
                       Stretch="UniformToFill"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Cancelar"
                        Margin="0,0,10,0"
                        Click="BtnCancelar_Click"/>

                <Button Content="Guardar"
                        Background="#C0E6A1"
                        Click="BtnGuardar_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
