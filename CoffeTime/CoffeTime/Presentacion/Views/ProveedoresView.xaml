<UserControl x:Class="CoffeTime.Presentacion.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Gestión de Proveedores"
                           Style="{StaticResource TitleText}"/>
                <TextBlock Text="Administra los proveedores de insumos"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource MainButton}"
                    Content="+  Nuevo Proveedor"
                    Padding="24,10"
                    Click="NuevoProveedor_Click"/>
        </Grid>

        <!-- LISTA DINÁMICA DE PROVEEDORES -->
        <ScrollViewer Grid.Row="1" Margin="0,30,0,0">
            <ItemsControl x:Name="ListaProveedores">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Width="330" Height="200" Margin="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ICONO + INFO -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40"
                                            Background="#FFF4D6"
                                            CornerRadius="12">
                                        <TextBlock Text="📦"
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextDarkBrush}"/>
                                        <TextBlock Text="{Binding Contacto}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextLightBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="20,0,0,0">
                                        <Button Content="✎"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{Binding Id}"
                                                Click="EditarProveedor_Click"/>
                                        <Button Content="🗑"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="5,0,0,0"
                                                Tag="{Binding Id}"
                                                Click="EliminarProveedor_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- EMAIL -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <TextBlock Text="✉"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Email}"
                                               Foreground="{StaticResource TextDarkBrush}"/>
                                </StackPanel>

                                <!-- TELÉFONO -->
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,40,0,0">
                                    <TextBlock Text="☎" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Telefono}"
                                               Foreground="{StaticResource TextDarkBrush}"/>
                                </StackPanel>

                                <!-- LÍNEA -->
                                <Rectangle Grid.Row="2"
                                           Fill="{StaticResource BorderBrush}"
                                           Height="1"
                                           Margin="0,10"/>

                                <!-- FECHA REGISTRO -->
                                <TextBlock Grid.Row="3"
                                           Text="{Binding FechaRegistro, StringFormat='Registrado: {0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextLightBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
