<Window x:Class="CoffeTime.Presentacion.Views.ProveedoresView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:comp="clr-namespace:CoffeTime.Presentacion.Components"

        Title="Gestión de Proveedores"
     Width="1300"
        Height="750"
        MinWidth="1200"
        MinHeight="750"
        Background="#FFF8F4E9"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- =======================
             FILAS DEL LAYOUT
        ======================== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- =======================
              HEADER GLOBAL
        ======================== -->
        <comp:Header Grid.Row="0"/>

        <!-- =======================
              CONTENIDO PRINCIPAL
        ======================== -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="30">

                <!-- Título -->
                <TextBlock Text="Gestión de Proveedores"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#7B4F1D"/>

                <TextBlock Text="Administra los proveedores de insumos"
                           FontSize="16"
                           Margin="0,5,0,25"
                           Foreground="#937755"/>

                <!-- BOTON NUEVO-->
                <Button x:Name="btnNuevo"
                        Content="➕  Nuevo Proveedor"
                        HorizontalAlignment="Left"
                        Padding="20,10"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#DA8A2D"
                        Cursor="Hand"
                        Margin="0,0,0,20"
                        Click="BtnNuevoProveedor_Click"/>

                <!-- LISTADO PROVEEDORES -->
                <ItemsControl x:Name="listaProveedores">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border CornerRadius="12"
                                    Padding="15"
                                    Margin="0,0,0,15"
                                    BorderBrush="#E8D5B5"
                                    BorderThickness="1"
                                    Background="White">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ICONO -->
                                    <Ellipse Width="40"
                                             Height="40"
                                             Fill="#F6E5B3"/>

                                    <!-- DATOS -->
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="Bold" Foreground="#7B4F1D"/>
                                        <TextBlock Text="{Binding Contacto}" Foreground="#6A6A6A"/>
                                        <TextBlock Text="{Binding Email}" Foreground="#6A6A6A"/>
                                        <TextBlock Text="{Binding Telefono}" Foreground="#6A6A6A"/>
                                    </StackPanel>

                                    <!-- BOTONES -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                        <Button Content="✏ Editar"
                                                Tag="{Binding Id}"
                                                Click="EditarProveedor"
                                                Background="#FDECC2"
                                                BorderBrush="#C9A96D"
                                                Margin="0,0,0,5"/>

                                        <Button Content="🗑 Eliminar"
                                                Tag="{Binding Id}"
                                                Click="EliminarProveedor"
                                                Background="#F8C4C4"
                                                BorderBrush="#DB6E6E"/>
                                    </StackPanel>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</Window>
