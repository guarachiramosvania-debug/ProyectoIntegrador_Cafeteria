<Window x:Class="CoffeTime.Presentacion.Views.InventarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:comp="clr-namespace:CoffeTime.Presentacion.Components"
        mc:Ignorable="d"
        Title="Gestión de Inventario"
        Width="1300"
        Height="750"
        MinWidth="1200"
        MinHeight="750"
        Background="#FFF8F4E9"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- HEADER GLOBAL -->
            <RowDefinition Height="Auto"/>
            <!-- CONTENIDO -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ************ HEADER GLOBAL ************ -->
        <comp:Header Grid.Row="0"/>

        <!-- ************ CONTENIDO PRINCIPAL ************ -->
        <Grid Grid.Row="1" Margin="30,15,30,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ================== PANEL IZQUIERDO: INVENTARIO ================== -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E6D5B8"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Título + botón (siempre visibles) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buscador -->
                        <RowDefinition Height="Auto"/>
                        <!-- DataGrid (scroll) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO + BOTÓN -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Inventario Actual"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#8B5E34"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="BtnRegistrarEntrada"
                                Content="+ Registrar Entrada"
                                Click="BtnRegistrarEntrada_Click"
                                Margin="15,0,0,0"
                                Padding="18,6"
                                Background="#FFB74D"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <Button.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="8"
                                                  ShadowDepth="1"
                                                  Opacity="0.25"/>
                            </Button.Effect>
                        </Button>
                    </Grid>

                    <!-- BUSCADOR -->
                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <TextBox x:Name="TxtBuscar"
                                 Height="30"
                                 Padding="28,3,8,3"
                                 TextChanged="TxtBuscar_TextChanged"
                                 Background="White"
                                 BorderBrush="#E1D5C4"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>

                        <!-- iconito de lupa (opcional, puedes quitarlo si quieres) -->
                        <TextBlock Text="🔍"
                                   VerticalAlignment="Center"
                                   Margin="8,0,699,0"
                                   FontSize="14"/>

                        <!-- placeholder manual -->
                    </Grid>

                    <!-- DATAGRID (SOLO ESTO SCROLLEA) -->
                    <DataGrid x:Name="DataGridInventarioActual"
                              Grid.Row="2"
                              Margin="0,15,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              RowBackground="White"
                              AlternatingRowBackground="#FFF9F3E7">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Insumo"
                        Binding="{Binding Nombre}"
                        Width="*"/>

                            <DataGridTextColumn Header="Proveedor"
                        Binding="{Binding Proveedor}"
                        Width="150"/>

                            <DataGridTextColumn Header="Stock"
                        Binding="{Binding Stock}"
                        Width="90"/>

                            <!-- NUEVA COLUMNA -->
                            <DataGridTextColumn Header="Unidad"
                        Binding="{Binding UnidadMedida}"
                        Width="100"/>

                            <DataGridTextColumn Header="Mínimo"
                        Binding="{Binding Minimo}"
                        Width="90"/>

                            <DataGridTemplateColumn Header="Estado" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,2"
                                                CornerRadius="10"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- Por defecto OK (verde) -->
                                                    <Setter Property="Background" Value="#D1F3D1"/>
                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    <Setter Property="BorderThickness" Value="1"/>

                                                    <Style.Triggers>
                                                        <!-- Cuando es 'Alerta' cambiamos a naranja -->
                                                        <DataTrigger Binding="{Binding Estado}" Value="Alerta">
                                                            <Setter Property="Background" Value="#FFE1B9"/>
                                                            <Setter Property="BorderBrush" Value="#FF9800"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding Estado}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#494949"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ================== PANEL DERECHO: HISTORIAL ================== -->
            <Border Grid.Column="1"
                    Margin="20,0,0,0"
                    Background="White"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#E6D5B8"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Historial de Entradas"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#8B5E34"/>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,15,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StackHistorial"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
